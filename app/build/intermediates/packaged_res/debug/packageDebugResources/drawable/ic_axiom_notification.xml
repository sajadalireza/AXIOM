<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
        AXIOM ◈ notification icon.
        Solid white only — Android tints it with the accent color automatically.
        Shape: outer diamond outline + small center diamond (◈ glyph).
    -->

    <!-- Outer diamond ring (stroke-simulated via filled shape minus inner) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M12,1.5 L22.5,12 L12,22.5 L1.5,12 Z
            M12,4.5 L19.5,12 L12,19.5 L4.5,12 Z"
        android:fillType="evenOdd" />

    <!-- Center dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,10 L14,12 L12,14 L10,12 Z" />

</vector>
